[ ca ]
default_ca = CA
[ CA ]
dir = .
database = $ENV::DB
new_certs_dir = .
serial = $ENV::SERIAL
default_md = sha256
policy = pol
default_days = 3650
default_crl_days = 30
unique_subject = no
copy_extensions = none
[ pol ]
commonName = supplied
organizationName = optional
countryName = optional
[ req ]
distinguished_name = dn

[ dn ]
commonName = CN
[ v3_root ]
basicConstraints = critical,CA:true
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
[ v3_inter ]
basicConstraints = critical,CA:true,pathlen:0
keyUsage = critical,keyCertSign,cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = OCSP;URI:http://127.0.0.1:8881,caIssuers;URI:http://127.0.0.1:8880/root.cer
crlDistributionPoints = URI:http://127.0.0.1:8880/root.crl
[ v3_leaf ]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature,nonRepudiation
extendedKeyUsage = emailProtection
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid
authorityInfoAccess = OCSP;URI:http://127.0.0.1:8882,caIssuers;URI:http://127.0.0.1:8880/inter.cer
crlDistributionPoints = URI:http://127.0.0.1:8880/inter.crl
[ v3_ocsp ]
basicConstraints = critical,CA:false
keyUsage = critical,digitalSignature
extendedKeyUsage = OCSPSigning
noCheck = ignored
authorityKeyIdentifier = keyid
